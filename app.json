{
  "expo": {
    "name": "HAEON SAFE",
    "slug": "haeon-safe-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "haeonsafe",
    "userInterfaceStyle": "light",
    "icon": "./pic/app-new.png",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지도와 긴급 신고에서 현재 위치를 확인하기 위해 위치 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "신고 사진과 영상을 첨부하기 위해 미디어 접근 권한이 필요합니다.",
          "cameraPermission": "신고 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.haeon.safe",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kr.haeon.safe",
      "adaptiveIcon": {
        "foregroundImage": "./pic/app-new.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1854b075-91c6-4d85-abf0-2730b3311172"
      }
    }
  }
}
